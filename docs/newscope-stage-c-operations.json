      "func TestServer_ArticlesAPI_EmptyAndDefaultLimit(t *testing.T) {",
      " srv, repos := metadataTestServer(t)",
      " empty := metadataRequest(t, srv, \"/api/v1/articles\")",
      " require.Equal(t, http.StatusOK, empty.Code)",
      " assert.JSONEq(t, `{\"items\":[],\"nextCursor\":null}`, empty.Body.String())",
      " _, err := repos.DB.Exec(\"INSERT INTO feeds (id, url, title) VALUES (1, 'https://example.invalid/feed', 'Feed')\")",
      " require.NoError(t, err)",
      " for i := range 101 {",
      "  _, err := repos.DB.Exec(`INSERT INTO items",
      "   (feed_id, guid, title, link, published, relevance_score, classified_at)",
      "   VALUES (1, ?, 'Title', 'https://example.invalid/', '2026-01-01 00:00:00', 0, CURRENT_TIMESTAMP)`,",
      "   strconv.Itoa(i))",
      "  require.NoError(t, err)",
      " }",
      " response := metadataRequest(t, srv, \"/api/v1/articles\")",
      " require.Equal(t, http.StatusOK, response.Code, response.Body.String())",
      " var page domain.ArticlePage",
      " require.NoError(t, json.Unmarshal(response.Body.Bytes(), &page))",
      " assert.Len(t, page.Items, 100)",
      " require.NotNil(t, page.NextCursor)",
      " response = metadataRequest(t, srv, \"/api/v1/articles?cursor=\"+url.QueryEscape(*page.NextCursor))",
      " require.Equal(t, http.StatusOK, response.Code, response.Body.String())",
      " require.NoError(t, json.Unmarshal(response.Body.Bytes(), &page))",
      " assert.Len(t, page.Items, 1)",
      " assert.Nil(t, page.NextCursor)",
      "}",

      "package domain",
      "",
      "import \"time\"",
      "",
      "// ArticleMetadata contains the public article metadata without article content.",
      "type ArticleMetadata struct {",
      "\tID string `json:\"id\"`",
      "\tGUID string `json:\"guid\"`",
      "\tTitle string `json:\"title\"`",
      "\tURL string `json:\"url\"`",
      "\tScore float64 `json:\"score\"`",
      "\tPublishedAt time.Time `json:\"publishedAt\"`",
      "\tTopics []string `json:\"topics\"`",
      "\tFeed ArticleFeed `json:\"feed\"`",
      "}",
      "",
      "// ArticleFeed identifies the source feed without its fetch configuration.",
      "type ArticleFeed struct {",
      "\tID string `json:\"id\"`",
      "\tTitle string `json:\"title\"`",
      "}",
      "",
      "// ArticlePage is a bounded metadata page; a nil cursor marks exhaustion.",
      "type ArticlePage struct {",
      "\tItems []ArticleMetadata `json:\"items\"`",
      "\tNextCursor *string `json:\"nextCursor\"`",
      "}",
      "",
      "// ArticlePageRequest specifies the metadata filters and opaque continuation token.",
      "type ArticlePageRequest struct {",
      "\tMinScore float64",
      "\tPublishedAfter *time.Time",
      "\tLimit int",
      "\tCursor string",
      "}",
      ""
    ]

      "package repository",
      "",
      "import (",
      " \"context\"",
      " \"crypto/hmac\"",
      " \"crypto/rand\"",
      " \"crypto/sha256\"",
      " \"encoding/base64\"",
      " \"encoding/json\"",
      " \"errors\"",
      " \"fmt\"",
      " \"math\"",
      " \"strconv\"",
      " \"strings\"",
      " \"time\"",
      "",
      " \"github.com/jmoiron/sqlx\"",
      "",
      " \"github.com/umputun/newscope/pkg/domain\"",
      ")",
      "",
      "// ArticleRepository reads bounded article metadata pages from the local database.",
      "type ArticleRepository struct {",
      " db *sqlx.DB",
      " cursorKey [32]byte",
      "}",
      "",
      "// NewArticleRepository creates a metadata reader with process-local cursor authentication.",
      "func NewArticleRepository(db *sqlx.DB) *ArticleRepository {",
      " r := &ArticleRepository{db: db}",
      " _, _ = rand.Read(r.cursorKey[:])",
      " return r",
      "}",
      "",
      "// ErrInvalidArticlePageRequest identifies invalid filters or continuation tokens.",
      "var ErrInvalidArticlePageRequest = errors.New(\"invalid article page request\")",
      "",
      "const articleQueryTimeout = 5 * time.Second",
      "const maxArticleCursorLength = 1024",
      "",
      "// articleCursor binds the insertion snapshot and keyset boundary to normalized filters.",
      "type articleCursor struct {",
      " Version int",
      " MinScore float64",
      " After string",
      " HighID int64",
      " LastID int64",
      " LastPublished string",
      "}",
      "",
      "type articleMetadataSQL struct {",
      " ID int64 `db:\"id\"`",
      " GUID string `db:\"guid\"`",
      " Title string `db:\"title\"`",
      " URL string `db:\"link\"`",
      " Score float64 `db:\"relevance_score\"`",
      " Published time.Time `db:\"published\"`",
      " PublishedKey string `db:\"published_key\"`",
      " Topics topicsSQL `db:\"topics\"`",
      " FeedID int64 `db:\"feed_id\"`",
      " FeedTitle string `db:\"feed_title\"`",
      "}",
      "",
      "// GetArticlePage returns metadata in descending (published, id) order without fetching sources.",
      "func (r *ArticleRepository) GetArticlePage(ctx context.Context, req domain.ArticlePageRequest) (domain.ArticlePage, error) {",
      " page := domain.ArticlePage{Items: []domain.ArticleMetadata{}}",
      " if err := validateArticlePageRequest(req); err != nil {",
      "  return page, err",
      " }",
      " cursor := articleCursor{Version: 1, MinScore: req.MinScore, After: articleAfterKey(req.PublishedAfter)}",
      " if req.Cursor != \"\" {",
      "  decoded, err := r.decodeCursor(req.Cursor)",
      "  if err != nil || decoded.MinScore != cursor.MinScore || decoded.After != cursor.After {",
      "   return page, fmt.Errorf(\"%w: cursor does not match request\", ErrInvalidArticlePageRequest)",
      "  }",
      "  cursor = decoded",
      " }",
      " ctx, cancel := context.WithTimeout(ctx, articleQueryTimeout)",
      " defer cancel()",
      " if req.Cursor == \"\" {",
      "  // all later inserts have larger autoincrement ids, including backdated articles.",
      "  if err := r.db.GetContext(ctx, &cursor.HighID, \"SELECT COALESCE(MAX(id), 0) FROM items\"); err != nil {",
      "   return page, fmt.Errorf(\"read article high water mark: %w\", err)",
      "  }",
      " }",
      " rows, err := r.readPage(ctx, req.Limit, cursor)",
      " if err != nil {",
      "  return page, err",
      " }",
      " hasMore := len(rows) > req.Limit",
      " if hasMore {",
      "  rows = rows[:req.Limit]",
      " }",
      " for _, row := range rows {",
      "  topics := []string(row.Topics)",
      "  if topics == nil {",
      "   topics = []string{}",
      "  }",
      "  page.Items = append(page.Items, domain.ArticleMetadata{",
      "   ID: strconv.FormatInt(row.ID, 10), GUID: row.GUID, Title: row.Title, URL: row.URL,",
      "   Score: row.Score, PublishedAt: row.Published.UTC(), Topics: topics,",
      "   Feed: domain.ArticleFeed{ID: strconv.FormatInt(row.FeedID, 10), Title: row.FeedTitle},",
      "  })",
      " }",
      " if hasMore {",
      "  last := rows[len(rows)-1]",
      "  cursor.LastID, cursor.LastPublished = last.ID, last.PublishedKey",
      "  token, err := r.encodeCursor(cursor)",
      "  if err != nil {",
      "   return page, err",
      "  }",
      "  page.NextCursor = &token",
      " }",
      " return page, nil",
      "}",
      "",
      "func (r *ArticleRepository) readPage(ctx context.Context, limit int, cursor articleCursor) ([]articleMetadataSQL, error) {",
      " query := `SELECT i.id, i.guid, i.title, i.link, i.relevance_score, i.published,",
      "  CAST(i.published AS TEXT) AS published_key, i.topics, i.feed_id, COALESCE(f.title, '') AS feed_title",
      "  FROM items i JOIN feeds f ON f.id = i.feed_id",
      "  WHERE i.classified_at IS NOT NULL AND i.relevance_score IS NOT NULL",
      "   AND i.relevance_score >= ? AND i.relevance_score <= 10",
      "   AND i.published IS NOT NULL AND i.id <= ?`",
      " args := []any{cursor.MinScore, cursor.HighID}",
      " if cursor.After != \"\" {",
      "  query += \" AND i.published > ?\"",
      "  args = append(args, cursor.After)",
      " }",
      " if cursor.LastID != 0 {",
      "  query += \" AND (i.published, i.id) < (?, ?)\"",
      "  args = append(args, cursor.LastPublished, cursor.LastID)",
      " }",
      " query += \" ORDER BY i.published DESC, i.id DESC LIMIT ?\"",
      " args = append(args, limit+1)",
      " var rows []articleMetadataSQL",
      " if err := r.db.SelectContext(ctx, &rows, query, args...); err != nil {",
      "  return nil, fmt.Errorf(\"read article metadata: %w\", err)",
      " }",
      " return rows, nil",
      "}",
      "",
      "func validateArticlePageRequest(req domain.ArticlePageRequest) error {",
      " if math.IsNaN(req.MinScore) || math.IsInf(req.MinScore, 0) || req.MinScore < 0 || req.MinScore > 10 {",
      "  return fmt.Errorf(\"%w: min_score must be between 0 and 10\", ErrInvalidArticlePageRequest)",
      " }",
      " if req.Limit < 1 || req.Limit > 100 {",
      "  return fmt.Errorf(\"%w: limit must be between 1 and 100\", ErrInvalidArticlePageRequest)",
      " }",
      " if len(req.Cursor) > maxArticleCursorLength {",
      "  return fmt.Errorf(\"%w: cursor too long\", ErrInvalidArticlePageRequest)",
      " }",
      " if req.PublishedAfter != nil && (req.PublishedAfter.UTC().Year() < 0 || req.PublishedAfter.UTC().Year() > 9999) {",
      "  return fmt.Errorf(\"%w: published_after out of range\", ErrInvalidArticlePageRequest)",
      " }",
      " return nil",
      "}",
      "",
      "func articleAfterKey(after *time.Time) string {",
      " if after == nil {",
      "  return \"\"",
      " }",
      " return after.UTC().Format(\"2006-01-02 15:04:05.999999999\")",
      "}",
      "",
      "func (r *ArticleRepository) encodeCursor(cursor articleCursor) (string, error) {",
      " payload, err := json.Marshal(cursor)",
      " if err != nil {",
      "  return \"\", fmt.Errorf(\"encode article cursor: %w\", err)",
      " }",
      " mac := hmac.New(sha256.New, r.cursorKey[:])",
      " _, _ = mac.Write(payload)",
      " return base64.RawURLEncoding.EncodeToString(payload) + \".\" + base64.RawURLEncoding.EncodeToString(mac.Sum(nil)), nil",
      "}",
      "",
      "func (r *ArticleRepository) decodeCursor(token string) (articleCursor, error) {",
      " var cursor articleCursor",
      " if len(token) > maxArticleCursorLength {",
      "  return cursor, ErrInvalidArticlePageRequest",
      " }",
      " body, signature, ok := strings.Cut(token, \".\")",
      " if !ok {",
      "  return cursor, ErrInvalidArticlePageRequest",
      " }",
      " payload, err := base64.RawURLEncoding.Strict().DecodeString(body)",
      " if err != nil {",
      "  return cursor, ErrInvalidArticlePageRequest",
      " }",
      " sig, err := base64.RawURLEncoding.Strict().DecodeString(signature)",
      " if err != nil {",
      "  return cursor, ErrInvalidArticlePageRequest",
      " }",
      " mac := hmac.New(sha256.New, r.cursorKey[:])",
      " _, _ = mac.Write(payload)",
      " if !hmac.Equal(sig, mac.Sum(nil)) || json.Unmarshal(payload, &cursor) != nil {",
      "  return cursor, ErrInvalidArticlePageRequest",
      " }",
      " if cursor.Version != 1 || cursor.LastID <= 0 || cursor.HighID < cursor.LastID {",
      "  return cursor, ErrInvalidArticlePageRequest",
      " }",
      " published, err := time.Parse(SQLiteDateFormat, cursor.LastPublished)",
      " if err != nil || published.Format(SQLiteDateFormat) != cursor.LastPublished {",
      "  return cursor, ErrInvalidArticlePageRequest",
      " }",
      " return cursor, nil",
      "}",
      ""
    ]
  },

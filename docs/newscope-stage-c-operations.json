      "func TestArticleRepository_GetArticlePage_ContextAndErrors(t *testing.T) {",
      " repos, cleanup := setupTestDB(t)",
      " defer cleanup()",
      " reader := NewArticleRepository(repos.DB)",
      " req := domain.ArticlePageRequest{Limit: 1}",
      " ctx, cancel := context.WithCancel(context.Background())",
      " cancel()",
      " _, err := reader.GetArticlePage(ctx, req)",
      " require.ErrorIs(t, err, context.Canceled)",
      " conn, err := repos.DB.Conn(context.Background())",
      " require.NoError(t, err)",
      " ctx, cancel = context.WithTimeout(context.Background(), 20*time.Millisecond)",
      " defer cancel()",
      " _, err = reader.GetArticlePage(ctx, req)",
      " require.ErrorIs(t, err, context.DeadlineExceeded, \"waiting for the only DB connection must respect the caller deadline\")",
      " require.NoError(t, conn.Close())",
      " _, err = repos.DB.Exec(\"DROP TABLE items\")",
      " require.NoError(t, err)",
      " _, err = reader.GetArticlePage(context.Background(), req)",
      " require.Error(t, err)",
      " assert.NotErrorIs(t, err, ErrInvalidArticlePageRequest)",
      "}",

      "func TestServer_ArticlesAPI_Validation(t *testing.T) {",
      " srv, _ := metadataTestServer(t)",
      " invalid := []string{",
      "  \"min_score=-1\", \"min_score=11\", \"min_score=NaN\", \"min_score=Inf\", \"min_score=-Inf\", \"min_score=abc\",",
      "  \"min_score=1e999\", \"min_score=\", \"min_score=1&min_score=2\",",
      "  \"limit=0\", \"limit=-1\", \"limit=101\", \"limit=1.5\", \"limit=\", \"limit=abc\", \"limit=1&limit=2\",",
      "  \"published_after=\", \"published_after=2026-01-01\", \"published_after=not-a-date\",",
      "  \"published_after=2026-01-01T0:00:00Z\", \"published_after=2026-01-01T00:00:00,5Z\",",
      "  \"published_after=2026-01-01T00:00:00%2B24:00\", \"published_after=2026-01-01T00:00:00%2B00:60\",",
      "  \"published_after=2026-02-30T00:00:00Z\", \"published_after=a&published_after=b\",",
      "  \"cursor=broken\", \"cursor=!.!\", \"cursor=a&cursor=b\", \"cursor=\"+strings.Repeat(\"x\", 1025),",
      "  \"unknown=1\", \"limit=1;min_score=1\", \"min_score=%ZZ\", strings.Repeat(\"x\", 4097),",
      " }",
      " for i, query := range invalid {",
      "  t.Run(fmt.Sprintf(\"invalid-%d\", i), func(t *testing.T) {",
      "   recorder := metadataRequest(t, srv, \"/api/v1/articles?\"+query)",
      "   assert.Equal(t, http.StatusBadRequest, recorder.Code, query)",
      "   assert.Equal(t, \"application/json\", recorder.Header().Get(\"Content-Type\"))",
      "  })",
      " }",
      " for _, query := range []string{\"min_score=0\", \"min_score=10\", \"min_score=8.5\", \"limit=1\", \"limit=100\", \"cursor=\",",
      "  \"published_after=2026-01-01T00:00:00.123456789Z\", \"published_after=2026-01-01T08:00:00%2B08:00\"} {",
      "  recorder := metadataRequest(t, srv, \"/api/v1/articles?\"+query)",
      "  assert.Equal(t, http.StatusOK, recorder.Code, query)",
      " }",
      "}",

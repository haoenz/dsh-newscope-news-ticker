      "func TestArticleRepository_GetArticlePage_CursorValidation(t *testing.T) {",
      " repos, cleanup := setupTestDB(t)",
      " defer cleanup()",
      " feed := createTestFeed(t, repos, \"metadata\")",
      " insertMetadataItem(t, repos, feed.ID, \"one\", \"2026-01-01 00:00:01\", 8, true)",
      " insertMetadataItem(t, repos, feed.ID, \"two\", \"2026-01-01 00:00:02\", 8, true)",
      " reader := NewArticleRepository(repos.DB)",
      " after := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)",
      " base := domain.ArticlePageRequest{Limit: 1, MinScore: 5, PublishedAfter: &after}",
      " page, err := reader.GetArticlePage(context.Background(), base)",
      " require.NoError(t, err)",
      " require.NotNil(t, page.NextCursor)",
      " base.Cursor = *page.NextCursor",
      " changed := after.Add(time.Second)",
      " cases := []struct {name string; mutate func(*domain.ArticlePageRequest)}{",
      "  {\"negative score\", func(req *domain.ArticlePageRequest) { req.MinScore = -1 }},",
      "  {\"large score\", func(req *domain.ArticlePageRequest) { req.MinScore = 11 }},",
      "  {\"nan\", func(req *domain.ArticlePageRequest) { req.MinScore = math.NaN() }},",
      "  {\"inf\", func(req *domain.ArticlePageRequest) { req.MinScore = math.Inf(1) }},",
      "  {\"zero limit\", func(req *domain.ArticlePageRequest) { req.Limit = 0 }},",
      "  {\"negative limit\", func(req *domain.ArticlePageRequest) { req.Limit = -1 }},",
      "  {\"large limit\", func(req *domain.ArticlePageRequest) { req.Limit = 101 }},",
      "  {\"malformed\", func(req *domain.ArticlePageRequest) { req.Cursor = \"invalid\" }},",
      "  {\"invalid base64\", func(req *domain.ArticlePageRequest) { req.Cursor = \"!.!\" }},",
      "  {\"too long\", func(req *domain.ArticlePageRequest) { req.Cursor = strings.Repeat(\"x\", 1025) }},",
      "  {\"tampered\", func(req *domain.ArticlePageRequest) { req.Cursor = \"A\" + req.Cursor[1:] }},",
      "  {\"changed score\", func(req *domain.ArticlePageRequest) { req.MinScore = 6 }},",
      "  {\"changed date\", func(req *domain.ArticlePageRequest) { req.PublishedAfter = &changed }},",
      "  {\"missing date\", func(req *domain.ArticlePageRequest) { req.PublishedAfter = nil }},",
      " }",
      " for _, tc := range cases {",
      "  t.Run(tc.name, func(t *testing.T) {",
      "   req := base",
      "   tc.mutate(&req)",
      "   _, err := reader.GetArticlePage(context.Background(), req)",
      "   require.ErrorIs(t, err, ErrInvalidArticlePageRequest)",
      "  })",
      " }",
      " t.Run(\"normalized filters and different limit\", func(t *testing.T) {",
      "  equivalent := after.In(time.FixedZone(\"offset\", 8*3600))",
      "  req := base",
      "  req.PublishedAfter, req.Limit = &equivalent, 100",
      "  result, err := reader.GetArticlePage(context.Background(), req)",
      "  require.NoError(t, err)",
      "  require.Len(t, result.Items, 1)",
      "  assert.Equal(t, \"one\", result.Items[0].GUID)",
      "  assert.Nil(t, result.NextCursor)",
      " })",
      " t.Run(\"restart invalidates cursor\", func(t *testing.T) {",
      "  _, err := NewArticleRepository(repos.DB).GetArticlePage(context.Background(), base)",
      "  require.ErrorIs(t, err, ErrInvalidArticlePageRequest)",
      " })",
      " cursor, err := reader.decodeCursor(base.Cursor)",
      " require.NoError(t, err)",
      " for _, field := range []string{\"version\", \"high\", \"id\", \"date\"} {",
      "  t.Run(\"invalid authenticated \"+field, func(t *testing.T) {",
      "   invalid := cursor",
      "   switch field {",
      "   case \"version\": invalid.Version = 2",
      "   case \"high\": invalid.HighID = invalid.LastID-1",
      "   case \"id\": invalid.LastID = 0",
      "   case \"date\": invalid.LastPublished = \"not-a-date\"",
      "   }",
      "   token, err := reader.encodeCursor(invalid)",
      "   require.NoError(t, err)",
      "   req := base",
      "   req.Cursor = token",
      "   _, err = reader.GetArticlePage(context.Background(), req)",
      "   require.ErrorIs(t, err, ErrInvalidArticlePageRequest)",
      "  })",
      " }",
      "}",

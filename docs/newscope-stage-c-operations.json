      " for i := range 101 {",
      "  insertMetadataItem(t, repos, feed.ID, strconv.Itoa(i), \"2026-01-01 00:00:00\", 8, true)",
      " }",
      " first, err := reader.GetArticlePage(context.Background(), domain.ArticlePageRequest{Limit: 100})",
      " require.NoError(t, err)",
      " require.Len(t, first.Items, 100)",
      " require.NotNil(t, first.NextCursor)",
      " last, err := reader.GetArticlePage(context.Background(), domain.ArticlePageRequest{Limit: 100, Cursor: *first.NextCursor})",
      " require.NoError(t, err)",
      " require.Len(t, last.Items, 1)",
      " assert.Nil(t, last.NextCursor)",
      " _, err = repos.DB.Exec(`INSERT INTO items (id, feed_id, guid, title, link, published, relevance_score, classified_at)",
      "  VALUES (9007199254740993, ?, 'big', 'big', 'https://example.invalid/big', '2026-02-01 00:00:00', 8, CURRENT_TIMESTAMP)`, feed.ID)",
      " require.NoError(t, err)",
      " large, err := reader.GetArticlePage(context.Background(), domain.ArticlePageRequest{Limit: 1})",
      " require.NoError(t, err)",
      " require.Len(t, large.Items, 1)",
      " assert.Equal(t, \"9007199254740993\", large.Items[0].ID)",
      " require.NotNil(t, large.NextCursor)",
      " continued, err := reader.GetArticlePage(context.Background(), domain.ArticlePageRequest{Limit: 1, Cursor: *large.NextCursor})",
      " require.NoError(t, err)",
      " require.Len(t, continued.Items, 1)",
      " assert.Equal(t, \"101\", continued.Items[0].ID)",
      "}",

      "package server",
      "",
      "import (",
      " \"context\"",
      " \"errors\"",
      " \"fmt\"",
      " \"log\"",
      " \"math\"",
      " \"net/http\"",
      " \"net/url\"",
      " \"regexp\"",
      " \"strconv\"",
      " \"time\"",
      "",
      " \"github.com/umputun/newscope/pkg/domain\"",
      " \"github.com/umputun/newscope/pkg/repository\"",
      ")",
      "",
      "// articlePager is separate from the UI database contract and exposes no mutations.",
      "type articlePager interface {",
      " GetArticlePage(context.Context, domain.ArticlePageRequest) (domain.ArticlePage, error)",
      "}",
      "",
      "// GetArticlePage reads metadata through the dedicated local database reader.",
      "func (r *RepositoryAdapter) GetArticlePage(ctx context.Context, req domain.ArticlePageRequest) (domain.ArticlePage, error) {",
      " if r.articleRepo == nil {",
      "  return domain.ArticlePage{}, errors.New(\"article metadata reader unavailable\")",
      " }",
      " return r.articleRepo.GetArticlePage(ctx, req)",
      "}",
      "",
      "func (s *Server) articlesAPIHandler(w http.ResponseWriter, r *http.Request) {",
      " req, err := parseArticlePageRequest(r.URL.RawQuery)",
      " if err != nil {",
      "  renderError(w, r, err, http.StatusBadRequest)",
      "  return",
      " }",
      " pager, ok := s.db.(articlePager)",
      " if !ok {",
      "  renderError(w, r, errors.New(\"article metadata unavailable\"), http.StatusServiceUnavailable)",
      "  return",
      " }",
      " ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)",
      " defer cancel()",
      " page, err := pager.GetArticlePage(ctx, req)",
      " if err != nil {",
      "  if ctx.Err() != nil {",
      "   err = ctx.Err()",
      "  }",
      "  switch {",
      "  case errors.Is(err, repository.ErrInvalidArticlePageRequest):",
      "   renderError(w, r, err, http.StatusBadRequest)",
      "  case errors.Is(err, context.DeadlineExceeded), errors.Is(err, context.Canceled):",
      "   renderError(w, r, errors.New(\"article metadata request timed out\"), http.StatusGatewayTimeout)",
      "  default:",
      "   log.Printf(\"[ERROR] article metadata query: %v\", err)",
      "   renderError(w, r, errors.New(\"article metadata unavailable\"), http.StatusInternalServerError)",
      "  }",
      "  return",
      " }",
      " w.Header().Set(\"Cache-Control\", \"no-store\")",
      " renderJSON(w, r, http.StatusOK, page)",
      "}",
      "",
      "var articleRFC3339 = regexp.MustCompile(`^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$`)",
      "",
      "func parseArticlePageRequest(rawQuery string) (domain.ArticlePageRequest, error) {",
      " req := domain.ArticlePageRequest{Limit: 100}",
      " if len(rawQuery) > 4096 {",
      "  return req, errors.New(\"article query too long\")",
      " }",
      " values, err := url.ParseQuery(rawQuery)",
      " if err != nil {",
      "  return req, errors.New(\"invalid article query\")",
      " }",
      " for name, entries := range values {",
      "  switch name {",
      "  case \"min_score\", \"published_after\", \"limit\", \"cursor\":",
      "  default:",
      "   return req, fmt.Errorf(\"unknown article query parameter: %s\", name)",
      "  }",
      "  if len(entries) != 1 || (entries[0] == \"\" && name != \"cursor\") {",
      "   return req, fmt.Errorf(\"invalid article query parameter: %s\", name)",
      "  }",
      " }",
      " if value := values.Get(\"min_score\"); value != \"\" {",
      "  req.MinScore, err = strconv.ParseFloat(value, 64)",
      "  if err != nil || math.IsNaN(req.MinScore) || math.IsInf(req.MinScore, 0) || req.MinScore < 0 || req.MinScore > 10 {",
      "   return req, errors.New(\"min_score must be between 0 and 10\")",
      "  }",
      " }",
      " if value := values.Get(\"limit\"); value != \"\" {",
      "  req.Limit, err = strconv.Atoi(value)",
      "  if err != nil || req.Limit < 1 || req.Limit > 100 {",
      "   return req, errors.New(\"limit must be between 1 and 100\")",
      "  }",
      " }",
      " if value := values.Get(\"published_after\"); value != \"\" {",
      "  after, err := time.Parse(time.RFC3339Nano, value)",
      "  if err != nil || !articleRFC3339.MatchString(value) || after.UTC().Year() < 0 || after.UTC().Year() > 9999 {",
      "   return req, errors.New(\"published_after must be RFC3339\")",
      "  }",
      "  req.PublishedAfter = &after",
      " }",
      " req.Cursor = values.Get(\"cursor\")",
      " if len(req.Cursor) > 1024 {",
      "  return req, errors.New(\"cursor too long\")",
      " }",
      " return req, nil",
      "}",
      ""
    ]

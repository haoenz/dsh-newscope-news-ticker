      "func TestServer_ArticlesAPI_ContextAndErrors(t *testing.T) {",
      " cases := []struct {name string; err error; code int}{",
      "  {\"invalid cursor\", repository.ErrInvalidArticlePageRequest, http.StatusBadRequest},",
      "  {\"deadline\", context.DeadlineExceeded, http.StatusGatewayTimeout},",
      "  {\"cancellation\", context.Canceled, http.StatusGatewayTimeout},",
      "  {\"database failure\", errors.New(\"private database path\"), http.StatusInternalServerError},",
      " }",
      " for _, tc := range cases {",
      "  t.Run(tc.name, func(t *testing.T) {",
      "   srv := &Server{db: &articlePagerStub{get: func(ctx context.Context, req domain.ArticlePageRequest) (domain.ArticlePage, error) {",
      "    deadline, ok := ctx.Deadline()",
      "    require.True(t, ok)",
      "    assert.LessOrEqual(t, time.Until(deadline), 5*time.Second)",
      "    assert.Equal(t, 100, req.Limit)",
      "    assert.Zero(t, req.MinScore)",
      "    return domain.ArticlePage{}, fmt.Errorf(\"wrapped: %w\", tc.err)",
      "   }}}",
      "   recorder := httptest.NewRecorder()",
      "   srv.articlesAPIHandler(recorder, httptest.NewRequest(http.MethodGet, \"/api/v1/articles\", http.NoBody))",
      "   assert.Equal(t, tc.code, recorder.Code)",
      "   assert.NotContains(t, recorder.Body.String(), \"private database path\")",
      "  })",
      " }",
      " t.Run(\"caller deadline preserved\", func(t *testing.T) {",
      "  ctx, cancel := context.WithTimeout(context.Background(), time.Second)",
      "  defer cancel()",
      "  parentDeadline, _ := ctx.Deadline()",
      "  srv := &Server{db: &articlePagerStub{get: func(ctx context.Context, _ domain.ArticlePageRequest) (domain.ArticlePage, error) {",
      "   deadline, ok := ctx.Deadline()",
      "   require.True(t, ok)",
      "   assert.Equal(t, parentDeadline, deadline)",
      "   return domain.ArticlePage{Items: []domain.ArticleMetadata{}}, nil",
      "  }}}",
      "  recorder := httptest.NewRecorder()",
      "  srv.articlesAPIHandler(recorder, httptest.NewRequest(http.MethodGet, \"/api/v1/articles\", http.NoBody).WithContext(ctx))",
      "  assert.Equal(t, http.StatusOK, recorder.Code)",
      " })",
      " t.Run(\"legacy database has no pager\", func(t *testing.T) {",
      "  srv := &Server{db: &mocks.DatabaseMock{}}",
      "  recorder := httptest.NewRecorder()",
      "  srv.articlesAPIHandler(recorder, httptest.NewRequest(http.MethodGet, \"/api/v1/articles\", http.NoBody))",
      "  assert.Equal(t, http.StatusServiceUnavailable, recorder.Code)",
      " })",
      " t.Run(\"interface adapter has no metadata reader\", func(t *testing.T) {",
      "  adapter := NewRepositoryAdapterWithInterfaces(nil, nil, nil, nil)",
      "  _, err := adapter.GetArticlePage(context.Background(), domain.ArticlePageRequest{Limit: 1})",
      "  require.Error(t, err)",
      " })",
      "}",
      "",
      "func TestServer_ArticlesAPI_MethodAndOrigin(t *testing.T) {",
      " srv, _ := metadataTestServer(t)",
      " post := httptest.NewRecorder()",
      " srv.router.ServeHTTP(post, httptest.NewRequest(http.MethodPost, \"/api/v1/articles\", http.NoBody))",
      " assert.Equal(t, http.StatusMethodNotAllowed, post.Code)",
      " crossOrigin := httptest.NewRecorder()",
      " req := httptest.NewRequest(http.MethodGet, \"/api/v1/articles\", http.NoBody)",
      " req.Header.Set(\"Origin\", \"https://other.invalid\")",
      " req.Header.Set(\"Sec-Fetch-Site\", \"cross-site\")",
      " srv.router.ServeHTTP(crossOrigin, req)",
      " assert.Equal(t, http.StatusOK, crossOrigin.Code, \"safe GET follows existing cross-origin protection behavior\")",
      " assert.Empty(t, crossOrigin.Header().Get(\"Access-Control-Allow-Origin\"))",
      " assert.Empty(t, crossOrigin.Header().Get(\"Access-Control-Allow-Credentials\"))",
      "}",

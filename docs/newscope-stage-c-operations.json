      "package repository",
      "",
      "import (",
      " \"context\"",
      " \"encoding/json\"",
      " \"math\"",
      " \"strconv\"",
      " \"strings\"",
      " \"testing\"",
      " \"time\"",
      "",
      " \"github.com/stretchr/testify/assert\"",
      " \"github.com/stretchr/testify/require\"",
      "",
      " \"github.com/umputun/newscope/pkg/domain\"",
      ")",
      "",
      "func insertMetadataItem(t *testing.T, repos *Repositories, feedID int64, guid string, published any, score any, classified bool) int64 {",
      " t.Helper()",
      " var classifiedAt any",
      " if classified { classifiedAt = \"2026-01-01 00:00:00\" }",
      " result, err := repos.DB.Exec(`INSERT INTO items",
      "  (feed_id, guid, title, link, published, relevance_score, classified_at, topics,",
      "   description, content, extracted_content, extracted_rich_content, summary)",
      "  VALUES (?, ?, ?, ?, ?, ?, ?, '[]', 'secret description', 'secret body', 'secret extraction', 'secret rich', 'secret summary')`,",
      "  feedID, guid, \"Title \"+guid, \"https://example.invalid/\"+guid, published, score, classifiedAt)",
      " require.NoError(t, err)",
      " id, err := result.LastInsertId()",
      " require.NoError(t, err)",
      " return id",
      "}",
      "",
      "func metadataIDs(page domain.ArticlePage) []string {",
      " ids := make([]string, 0, len(page.Items))",
      " for _, item := range page.Items { ids = append(ids, item.ID) }",
      " return ids",
      "}",
      "",
      "func TestArticleRepository_GetArticlePage_KeysetAndInsertionBoundary(t *testing.T) {",
      " repos, cleanup := setupTestDB(t)",
      " defer cleanup()",
      " feed := createTestFeed(t, repos, \"metadata\")",
      " older := insertMetadataItem(t, repos, feed.ID, \"older\", \"2026-01-01 00:00:00\", 8, true)",
      " tie1 := insertMetadataItem(t, repos, feed.ID, \"tie1\", \"2026-01-02 00:00:00\", 8, true)",
      " tie2 := insertMetadataItem(t, repos, feed.ID, \"tie2\", \"2026-01-02 00:00:00\", 8, true)",
      " newest := insertMetadataItem(t, repos, feed.ID, \"newest\", \"2026-01-03 00:00:00\", 8, true)",
      " reader := NewArticleRepository(repos.DB)",
      " req := domain.ArticlePageRequest{Limit: 2}",
      " first, err := reader.GetArticlePage(context.Background(), req)",
      " require.NoError(t, err)",
      " require.Equal(t, []string{strconv.FormatInt(newest, 10), strconv.FormatInt(tie2, 10)}, metadataIDs(first))",
      " require.NotNil(t, first.NextCursor)",
      " assert.LessOrEqual(t, len(*first.NextCursor), maxArticleCursorLength)",
      " insertMetadataItem(t, repos, feed.ID, \"inserted-new\", \"2026-02-01 00:00:00\", 9, true)",
      " insertMetadataItem(t, repos, feed.ID, \"inserted-backdated\", \"2025-01-01 00:00:00\", 9, true)",
      " req.Cursor = *first.NextCursor",
      " second, err := reader.GetArticlePage(context.Background(), req)",
      " require.NoError(t, err)",
      " assert.Equal(t, []string{strconv.FormatInt(tie1, 10), strconv.FormatInt(older, 10)}, metadataIDs(second))",
      " assert.Nil(t, second.NextCursor, \"an exactly full final page must not advertise another page\")",
      " replay, err := reader.GetArticlePage(context.Background(), req)",
      " require.NoError(t, err)",
      " assert.Equal(t, second, replay)",
      " req.Cursor, req.Limit = \"\", 100",
      " restarted, err := reader.GetArticlePage(context.Background(), req)",
      " require.NoError(t, err)",
      " assert.Len(t, restarted.Items, 6)",
      " assert.Nil(t, restarted.NextCursor)",
      "}",
      "",
      "func TestArticleRepository_GetArticlePage_FiltersAndMetadata(t *testing.T) {",
      " repos, cleanup := setupTestDB(t)",
      " defer cleanup()",
      " feed := createTestFeed(t, repos, \"metadata\")",
      " insertMetadataItem(t, repos, feed.ID, \"zero\", \"2026-01-01 00:00:00\", 0, true)",
      " insertMetadataItem(t, repos, feed.ID, \"ten\", \"2026-01-01 00:00:01\", 10, true)",
      " insertMetadataItem(t, repos, feed.ID, \"eight\", \"2026-01-01 00:00:02\", 8, true)",
      " insertMetadataItem(t, repos, feed.ID, \"unclassified\", \"2026-01-01 00:00:03\", 9, false)",
      " insertMetadataItem(t, repos, feed.ID, \"null-score\", \"2026-01-01 00:00:04\", nil, true)",
      " insertMetadataItem(t, repos, feed.ID, \"negative\", \"2026-01-01 00:00:05\", -1, true)",
      " insertMetadataItem(t, repos, feed.ID, \"out-of-range\", \"2026-01-01 00:00:06\", 11, true)",
      " insertMetadataItem(t, repos, feed.ID, \"no-date\", nil, 9, true)",
      " _, err := repos.DB.Exec(\"UPDATE items SET topics = 'null' WHERE guid = 'eight'\")",
      " require.NoError(t, err)",
      " reader := NewArticleRepository(repos.DB)",
      " cases := []struct {name string; min float64; after string; want []string}{",
      "  {name: \"all scored\", want: []string{\"eight\", \"ten\", \"zero\"}},",
      "  {name: \"maximum inclusive\", min: 10, want: []string{\"ten\"}},",
      "  {name: \"fractional score\", min: 8.5, want: []string{\"ten\"}},",
      "  {name: \"exclusive date\", after: \"2026-01-01T00:00:00Z\", want: []string{\"eight\", \"ten\"}},",
      "  {name: \"fractional date\", after: \"2026-01-01T00:00:01.5Z\", want: []string{\"eight\"}},",
      "  {name: \"offset date\", after: \"2026-01-01T08:00:00+08:00\", want: []string{\"eight\", \"ten\"}},",
      "  {name: \"empty\", after: \"2026-01-02T00:00:00Z\", want: []string{}},",
      " }",
      " for _, tc := range cases {",
      "  t.Run(tc.name, func(t *testing.T) {",
      "   req := domain.ArticlePageRequest{Limit: 100, MinScore: tc.min}",
      "   if tc.after != \"\" {",
      "    after, err := time.Parse(time.RFC3339Nano, tc.after)",
      "    require.NoError(t, err)",
      "    req.PublishedAfter = &after",
      "   }",
      "   page, err := reader.GetArticlePage(context.Background(), req)",
      "   require.NoError(t, err)",
      "   guids := []string{}",
      "   for _, item := range page.Items {",
      "    guids = append(guids, item.GUID)",
      "    assert.Equal(t, strconv.FormatInt(feed.ID, 10), item.Feed.ID)",
      "    assert.Equal(t, feed.Title, item.Feed.Title)",
      "    assert.NotNil(t, item.Topics)",
      "    assert.Equal(t, time.UTC, item.PublishedAt.Location())",
      "   }",
      "   assert.Equal(t, tc.want, guids)",
      "   assert.NotNil(t, page.Items)",
      "   assert.Nil(t, page.NextCursor)",
      "   data, err := json.Marshal(page)",
      "   require.NoError(t, err)",
      "   assert.NotContains(t, string(data), \"secret\")",
      "   assert.NotContains(t, string(data), \"summary\")",
      "   assert.NotContains(t, string(data), \"content\")",
      "  })",
      " }",
      "}",

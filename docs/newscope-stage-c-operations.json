      "func TestServer_ArticlesAPI_MetadataPagination(t *testing.T) {",
      " srv, repos := metadataTestServer(t)",
      " _, err := repos.DB.Exec(\"INSERT INTO feeds (id, url, title) VALUES (1, 'https://example.invalid/feed', 'Feed')\")",
      " require.NoError(t, err)",
      " for _, guid := range []string{\"one\", \"two\", \"three\"} {",
      "  _, err = repos.DB.Exec(`INSERT INTO items (feed_id, guid, title, link, published, relevance_score,",
      "   classified_at, topics, description, content, extracted_content, summary)",
      "   VALUES (1, ?, 'Title', 'https://example.invalid/article', '2026-01-01 00:00:01', 8,",
      "   CURRENT_TIMESTAMP, '[]', 'SECRET', 'SECRET', 'SECRET', 'SECRET')`, guid)",
      "  require.NoError(t, err)",
      " }",
      " var writesBefore int64",
      " require.NoError(t, repos.DB.Get(&writesBefore, \"SELECT total_changes()\"))",
      " recorder := metadataRequest(t, srv, \"/api/v1/articles?limit=2&min_score=8&published_after=2026-01-01T00:00:00Z\")",
      " require.Equal(t, http.StatusOK, recorder.Code, recorder.Body.String())",
      " assert.Equal(t, \"application/json\", recorder.Header().Get(\"Content-Type\"))",
      " assert.Equal(t, \"no-store\", recorder.Header().Get(\"Cache-Control\"))",
      " assert.Empty(t, recorder.Header().Get(\"Access-Control-Allow-Origin\"))",
      " assert.NotContains(t, recorder.Body.String(), \"SECRET\")",
      " var raw map[string]any",
      " require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &raw))",
      " require.Len(t, raw, 2)",
      " items := raw[\"items\"].([]any)",
      " require.Len(t, items, 2)",
      " item := items[0].(map[string]any)",
      " require.Len(t, item, 8)",
      " assert.Equal(t, \"3\", item[\"id\"])",
      " assert.Equal(t, \"three\", item[\"guid\"])",
      " assert.Equal(t, \"Title\", item[\"title\"])",
      " assert.Equal(t, \"https://example.invalid/article\", item[\"url\"])",
      " assert.Equal(t, float64(8), item[\"score\"])",
      " assert.Equal(t, \"2026-01-01T00:00:01Z\", item[\"publishedAt\"])",
      " assert.Equal(t, []any{}, item[\"topics\"])",
      " assert.Equal(t, map[string]any{\"id\":\"1\", \"title\":\"Feed\"}, item[\"feed\"])",
      " token, ok := raw[\"nextCursor\"].(string)",
      " require.True(t, ok)",
      " require.NotEmpty(t, token)",
      " query := url.Values{\"limit\":{\"2\"}, \"min_score\":{\"8\"}, \"published_after\":{\"2026-01-01T08:00:00+08:00\"}, \"cursor\":{token}}",
      " last := metadataRequest(t, srv, \"/api/v1/articles?\"+query.Encode())",
      " require.Equal(t, http.StatusOK, last.Code, last.Body.String())",
      " var page domain.ArticlePage",
      " require.NoError(t, json.Unmarshal(last.Body.Bytes(), &page))",
      " require.Len(t, page.Items, 1)",
      " assert.Equal(t, \"1\", page.Items[0].ID)",
      " assert.Nil(t, page.NextCursor)",
      " query.Set(\"min_score\", \"9\")",
      " mismatch := metadataRequest(t, srv, \"/api/v1/articles?\"+query.Encode())",
      " assert.Equal(t, http.StatusBadRequest, mismatch.Code)",
      " query.Set(\"min_score\", \"8\")",
      " query.Del(\"published_after\")",
      " mismatch = metadataRequest(t, srv, \"/api/v1/articles?\"+query.Encode())",
      " assert.Equal(t, http.StatusBadRequest, mismatch.Code)",
      " var writesAfter int64",
      " require.NoError(t, repos.DB.Get(&writesAfter, \"SELECT total_changes()\"))",
      " assert.Equal(t, writesBefore, writesAfter, \"the endpoint must not mutate local state\")",
      "}",

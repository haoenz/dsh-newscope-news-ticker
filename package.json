{
  "name": "dsh-newscope-news-ticker",
  "version": "1.2.1",
  "description": "A Newscope-backed interactive news ticker for the DSH Agent running status line.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-shell"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./news": "./lib/news.js",
    "./config": "./lib/config.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "VERIFICATION.zh.md",
    "docs/*.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:host": "node --test test/host.test.js",
    "test:client": "node --test test/client.test.js",
    "test:browser": "node test/browser-acceptance.mjs",
    "test:original:http": "node test/original-server-acceptance.mjs",
    "test:original:browser": "node test/browser-original-acceptance.mjs",
    "check": "node --check lib/index.js && node --check client.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.3.4",
    "parse5": "^8.1.0"
  },
  "devDependencies": {
    "jsdom": "^27.1.0",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
